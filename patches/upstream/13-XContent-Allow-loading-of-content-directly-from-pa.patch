+class ContentListDialog final : public ui::ImGuiDialog {
+ public:
+  ContentListDialog(ui::ImGuiDrawer* imgui_drawer,
+                    EmulatorWindow& emulator_window,
+                    kernel::xam::ContentManager* content_manager)
