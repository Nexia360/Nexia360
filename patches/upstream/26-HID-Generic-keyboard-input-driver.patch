         auto it = std::find_if(
             creators_.cbegin(), creators_.cend(),
             [&name](const auto& f) { return name.compare(f.name) == 0; });
@@ -246,7 +249,7 @@ class EmulatorApp final : public xe::ui::WindowedApp {
