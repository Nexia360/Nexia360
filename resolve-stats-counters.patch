+// Resolve readback measurement. Aggregated and reported on an interval rather
+// than per resolve - per-resolve logging is louder than the thing being
+// measured and distorts the timings it is meant to report.
+struct ResolveStats {
+  uint64_t window_start_ms = 0;
+  uint64_t frames = 0;
+  uint64_t resolves = 0;         // resolves that reached the readback path
+  uint64_t resolves_skipped = 0; // scaled, or destination not writable
+  uint64_t bytes = 0;            // bytes copied into guest memory
+  uint64_t gpu_wait_us = 0;      // time blocked waiting for the GPU
+  uint64_t copy_us = 0;          // Map + copy into guest memory
+  uint64_t stalls = 0;           // how many resolves had to wait at all
+
+  void Reset(uint64_t now_ms) {
+    const uint64_t start = now_ms;
+    *this = ResolveStats();
+    window_start_ms = start;
+  }
+};
+
+ResolveStats g_resolve_stats;
+
+uint64_t NowMicroseconds() {
+  return xe::Clock::QueryHostTickCount() * 1000000ull /
+         xe::Clock::host_tick_frequency_platform();
+}
