+Value* AddDidOverflow(PPCHIRBuilder& f, Value* v1, Value* v2, Value* r) {
+  return f.Truncate(f.Shr(f.And(f.Xor(v1, r), f.Xor(v2, r)), 63), INT8_TYPE);
