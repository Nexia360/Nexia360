+// Signed overflow of r = v1 - v2: the operands differ in sign and the result
+// sign differs from the minuend.
+Value* SubDidOverflow(PPCHIRBuilder& f, Value* v1, Value* v2, Value* r) {
+  return f.Truncate(f.Shr(f.And(f.Xor(v1, v2), f.Xor(v1, r)), 63), INT8_TYPE);
