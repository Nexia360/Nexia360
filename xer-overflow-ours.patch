+// not fit the 32-bit result the word forms define.
+Value* DidOverflow32(PPCHIRBuilder& f, Value* r) {
+  return f.CompareNE(f.SignExtend(f.Truncate(r, INT32_TYPE), INT64_TYPE), r);
